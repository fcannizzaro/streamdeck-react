{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "@fcannizzaro/streamdeck-react#build": {
      "outputs": ["dist/**"]
    },
    "@fcannizzaro/streamdeck-react-devtools#build": {
      "outputs": ["dist/**"]
    },
    "@fcannizzaro/streamdeck-simulator#build": {
      "dependsOn": ["@fcannizzaro/streamdeck-react#build"],
      "outputs": ["dist/**"]
    },
    "docs#build": {
      "dependsOn": ["@fcannizzaro/streamdeck-react-devtools#build"],
      "outputs": ["out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "cache": false
    },
    "link": {
      "cache": false
    }
  }
}
