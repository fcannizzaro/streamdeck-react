{
  "name": "@fcannizzaro/streamdeck-react-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "samples/*"
  ],
  "scripts": {
    "test": "turbo run test --filter='./packages/*'",
    "build": "turbo run build --filter='./packages/*'",
    "build:all": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --filter='./samples/*'",
    "format": "oxfmt",
    "link": "turbo run link --filter='./samples/*'"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/bun": "1.3.11",
    "oxfmt": "^0.43.0",
    "turbo": "2.9.3",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.10"
}
