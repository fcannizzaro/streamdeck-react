{
  "name": "@fcannizzaro/streamdeck-react-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "samples/*",
    "docs"
  ],
  "scripts": {
    "test": "turbo run test --filter='./packages/*'",
    "build": "turbo run build --filter='./packages/*'",
    "build:all": "turbo run build",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/bun": "1.3.10",
    "oxfmt": "^0.36.0",
    "turbo": "2.8.14",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.10"
}
